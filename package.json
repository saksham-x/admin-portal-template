{
  "name": "admin-vue3-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "build:icons": "tsx src/plugins/iconify/build-icons.ts",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "type-check": "vue-tsc --noEmit",
    "postinstall": "npm run build:icons",
    "deploy": "pnpm build && aws s3 sync dist/ s3://cdn.droneguru.com.np/portal --delete --endpoint-url=https://s3.ap-southeast-1.wasabisys.com --profile=wasabi"
  },
  "dependencies": {
    "@antfu/utils": "^9.2.1",
    "@casl/vue": "^2.2.2",
