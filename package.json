    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vueup/vue-quill": "^1.2.0",
    "@vueuse/core": "^13.9.0",
    "apexcharts": "3.45.2",
    "axios": "^1.12.2",
    "cookie-es": "^2.0.0",
    "cypress": "^15.7.0",
    "deepmerge": "^4.3.1",
    "destr": "^2.0.5",
    "flatpickr": "^4.6.13",
    "nepali-date-converter": "^3.4.0",
    "pinia": "^3.0.3",
    "quill": "^2.0.3",
    "tsx": "^4.20.6",
    "vue": "^3.5.22",
    "vue-axios": "^3.5.2",
    "vue-flatpickr-component": "^12.0.0",
    "vue-prism-component": "^2.0.0",
    "vue-recaptcha": "2.0.3",
    "vue-router": "^4.5.1",
    "vue3-apexcharts": "1.5.3",
    "vue3-confirm-dialog-box": "^1.1.4",
    "vue3-draggable-next": "^4.1.4",
    "vue3-notification": "^0.0.4",
    "vue3-perfect-scrollbar": "^2.0.0",
    "vue3-router-tab": "^1.3.9",
    "vuetify": "^3.10.9",
    "webfontloader": "^1.6.28"
